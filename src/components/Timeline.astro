---
import type { TimelineItem } from '../data/types';
import TimelineMobile from './TimelineMobile.astro';
import TimelineDesktop from './TimelineDesktop.astro';

interface Props {
  timelineTitle: string;
  timeline: TimelineItem[];
  futureText: string;
}

const { timelineTitle, timeline, futureText } = Astro.props;
---

<div class="timeline-mobile-wrapper">
  <TimelineMobile 
    timelineTitle={timelineTitle} 
    timeline={timeline} 
    futureText={futureText} 
  />
</div>

<div class="timeline-desktop-wrapper">
  <TimelineDesktop 
    timelineTitle={timelineTitle} 
    timeline={timeline} 
    futureText={futureText} 
  />
</div>

<style>
  .timeline-mobile-wrapper {
    display: none;
    width: 100%;
  }

  .timeline-desktop-wrapper {
    display: block;
    width: 100%;
  }

  @media (max-width: 768px) {
    .timeline-mobile-wrapper {
      display: block;
    }

    .timeline-desktop-wrapper {
      display: none;
    }
  }
</style>
